.program dcc_decoder

.define PREAMBLE_BITS 10    ; jmp x-- loop counts PREAMBLE_BITS+1 "1"s (S-9.2: accept >=10, require <=12)
.define ZERO_DELAY 30       ; sample 75us after the rising edge (30 * 2.5us)

; Wakeups: the CPU sleeps on IRQ flag 0, not on the RX FIFO. The flag is raised once a frame is
; complete, so a frame of up to STATUS_N (MID_FRAME_WAKE_LEVEL in pio_decoder.rs) words
; (12 bytes, every S-9.2/S-9.2.1 packet) costs a single wakeup. Longer frames also raise it
; mid-frame once the RX FIFO holds STATUS_N words (EXECCTRL STATUS_SEL = RX level, configured by
; the host) so the CPU drains it before it overflows.
;
; Output format: one RX FIFO word holds up to three 9-bit tokens behind a sentinel bit.
; Shift direction left, autopush OFF. A word reads (MSB->LSB):
;     0..0 1 [d7..d0 s] [d7..d0 s] [d7..d0 s]
;            [ byte 1 ] [ byte 2 ] [ byte 3 ]
; The sentinel `1` sits at bit 9*n, where n (1..=3) is the token count. Data bits are
; inverted (a sampled high = a DCC `0`). The trailing `s` bit records the bit that followed the
; byte: 1 = a data byte start bit (another byte follows), 0 = the packet end bit.
; OSR is never used for output; it holds 0xFFFFFFFF as a constant source of `1`s.
; The program uses all 32 instruction slots.

    mov osr, ~null              ; runs once at program entry
new_preamble:
    set x, PREAMBLE_BITS
preamble_candidate:
    wait 0 pin 0                ; wait for the pin to go low
    wait 1 pin 0 [ZERO_DELAY-1] ; once the pin goes high wait 75us
    jmp pin new_preamble        ; if the pin is still high after 75us - it must be a `0` - invalid preamble
    jmp x-- preamble_candidate  ; go back to the beginning to wait for an additional `1`, or continue on the 11th `1`

    ; if we've made it this far, we have a valid preamble, now we need to find the packet start bit (a zero)
    ; A command station sends at least 14 `1`s, so more may follow before the start bit: keep accepting them
packet_start:
    wait 0 pin 0                ; wait for the pin to go low
    wait 1 pin 0 [ZERO_DELAY-1] ; once the pin goes high wait 75us
    jmp pin new_word            ; If the pin is high, it's a `0` (packet start bit), so start decoding the first data bit
    jmp packet_start            ; else the pin is low, it must have been another `1`, wait for the next bit
new_word:
    in osr, 1                   ; sentinel
    set x, 2                    ; up to 3 tokens per word
new_token:
    set y, 7                    ; 8 data bits
read_bit:
    wait 0 pin 0
    wait 1 pin 0 [ZERO_DELAY-1]
    in pins, 1
    jmp y-- read_bit            ; if we havent read the data byte, keep reading bits

    ; read the separator bit to determine if it is a data start byte or a packet end bit
    wait 0 pin 0
    wait 1 pin 0 [ZERO_DELAY-1]
    jmp pin more                ; still high: a data byte start bit, another byte follows
    in null, 1                  ; s = 0: packet end bit
    push noblock                ; flush partial word
    irq nowait 0                ; frame complete: wake the CPU
    set x, (PREAMBLE_BITS-1)    ; packet end bit counts toward the next preamble (S-9.2 note 3)
    jmp preamble_candidate
more:
    in osr, 1                   ; s = 1
    jmp x-- new_token
    push noblock                ; word full (3 tokens)
    mov x, status               ; all-ones while RX FIFO level < STATUS_N
    jmp x-- new_word            ; room left: the CPU sleeps until the frame ends
    irq nowait 0                ; long frame filling the FIFO: wake the CPU to drain it
    jmp new_word
